# Settings for the local stack: the api and the worker. Copy to `.env` (git-ignored) and fill in
# what you need:
#
#   cp .env.example .env
#
# compose.dev.yaml reads `.env` when it exists and starts without it when it does not.

# Postgres connection string the api and worker read; required, no default.
DATABASE_URL=

# Comma-separated connectors to run discovery for; only `stub` exists today, blank means no
# connectors.
PLATFORM_CONNECTORS=

# Second switch the stub needs; `true` only together with PLATFORM_CONNECTORS=stub.
ALLOW_STUB_CONNECTORS=

# How many people the stub invents per run, 1-5000; absent means 250.
STUB_PEOPLE=

# Seconds between discovery runs, 1-31536000; absent means 900.
SYNC_INTERVAL_SECONDS=

# Plans 2-5 add the platform credentials (Twitch, Discord, YouTube) to this file.
