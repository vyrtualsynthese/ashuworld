# Settings for the local stack: the api and the worker. Copy to `.env` (git-ignored) and fill in
# what you need:
#
#   cp .env.example .env
#
# compose.dev.yaml reads `.env` when it exists and starts without it when it does not.

# Postgres connection string the api and worker read; required, no default.
DATABASE_URL=

# Comma-separated connectors to run discovery for: `stub` and/or `twitch`; blank means no
# connectors.
PLATFORM_CONNECTORS=

# Second switch the stub needs; `true` only together with PLATFORM_CONNECTORS=stub.
ALLOW_STUB_CONNECTORS=

# How many people the stub invents per run, 1-5000; absent means 250.
STUB_PEOPLE=

# Seconds between discovery runs, 1-31536000; absent means 900.
SYNC_INTERVAL_SECONDS=

# Twitch. The api and the worker share the application pair and the channel login; the worker
# alone reads the channel's refresh token and the sealing key. The client id and secret are set
# together or not at all: half a pair stops startup and names the missing half.

# The application's client id, from https://dev.twitch.tv/console/apps.
TWITCH_CLIENT_ID=

# The application's client secret. It stays in the processes; the browser never sees it.
TWITCH_CLIENT_SECRET=

# The channel fans are checked against: the lowercase login from the channel URL, so `ashuworld`
# and not the display name.
TWITCH_CHANNEL_LOGIN=

# Worker only. The channel owner's refresh token, printed once by
# `pnpm --filter @ashuworld/worker twitch-authorize`; it seeds the grant the worker then rotates
# in the database. The printed line is the only copy you keep.
TWITCH_CHANNEL_REFRESH_TOKEN=

# Worker only. 32 random bytes, base64, sealing the stored grants; generate one with
# `openssl rand -base64 32`. Keep it stable: a different key cannot open the stored grant, so the
# follower poll stops. Put the previous key back, or delete the stored `twitch` row in
# `platform_tokens` and authorize again.
PLATFORM_TOKEN_KEY=

# Discord and YouTube credentials join this file when their adapters land.
